{
  "name": "manager-insight-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Phase-one execution protocol and data normalization scripts for the Manager Insight MVP.",
  "scripts": {
    "front:case04": "node scripts/demo/run_front_pipeline.js --input-dir data/fixtures/feishu_cli_case_04_simulated_5d --output-dir data/outputs/demo/case04/current",
    "metrics:case04": "node scripts/demo/run_hard_metrics.js --input-dir data/outputs/demo/case04/current --output data/outputs/demo/case04/current/hard_metrics_result.json",
    "plan:case04": "node scripts/demo/run_evaluation_planner.js --input-dir data/outputs/demo/case04/current --output data/outputs/demo/case04/current/evaluation_plan.json",
    "review:management:case04": "node scripts/demo/run_management_reviewer.js --input-dir data/outputs/demo/case04/current --request-output data/outputs/demo/case04/current/management_reviewer_request.json",
    "audit:risk-behavior:case04": "node scripts/demo/run_risk_behavior_auditor.js --input-dir data/outputs/demo/case04/current --request-output data/outputs/demo/case04/current/risk_behavior_auditor_request.json",
    "review:coordination:case04": "node scripts/demo/run_coordination_lens.js --input-dir data/outputs/demo/case04/current --request-output data/outputs/demo/case04/current/coordination_lens_request.json",
    "assess:capability:case04": "node scripts/demo/run_capability_assessor.js --input-dir data/outputs/demo/case04/current --request-output data/outputs/demo/case04/current/capability_assessor_request.json --output data/outputs/demo/case04/current/capability_assessor_result.json",
    "report:case04": "node scripts/demo/run_report_writer.js --input-dir data/outputs/demo/case04/current --request-output data/outputs/demo/case04/current/report_writer_request.json --output data/outputs/demo/case04/current/report_result.json",
    "observability:write": "node scripts/dev/write_full_loop_observability_md.js",
    "observability:case04": "node scripts/dev/write_full_loop_observability_md.js --input-dir data/outputs/demo/case04/current --output docs/observability/case04_full_loop_observability.md --title \"Case 04 Full Loop Observability\"",
    "observability:case05": "node scripts/dev/write_full_loop_observability_md.js --input-dir data/outputs/demo/case05/auto --output docs/observability/case05_full_loop_observability.md --title \"Case 05 Full Loop Observability\"",
    "validate:smoke": "node scripts/dev/run_schema_validation_smoke.js",
    "writeback:csv:case04": "node scripts/dev/write_feishu_base_csv.js --input-dir data/outputs/demo/case04/current --output-dir data/outputs/demo/case04/feishu_base_csv",
    "demo": "node scripts/demo/run_front_pipeline.js --input-dir data/fixtures/feishu_cli_case_04_simulated_5d --output-dir data/outputs/demo/case04/current",
    "auto:case05": "node scripts/demo/run_evaluation_automation.js --input-dir data/fixtures/feishu_cli_case_05_desktop_robot --output-dir data/outputs/demo/case05/auto",
    "auto:case06": "node scripts/demo/run_evaluation_automation.js --input-dir data/fixtures/feishu_cli_case_06_desktop_robot --output-dir data/outputs/demo/case06/auto",
    "observability:case06": "node scripts/dev/write_full_loop_observability_md.js --input-dir data/outputs/demo/case06/auto --output docs/observability/case06_full_loop_observability.md --title \"Case 06 Full Loop Observability\"",
    "automation:run": "node scripts/demo/run_evaluation_automation.js",
    "bot:server": "node scripts/dev/run_feishu_bot_server.js --port 3030"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
