{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report_result.schema.json",
  "title": "ReportResult",
  "type": "object",
  "required": [
    "report_status",
    "report_title",
    "manager_id",
    "project_id",
    "report_type",
    "summary",
    "indicator_results",
    "score_overview",
    "key_evidence",
    "risk_alerts",
    "human_review_items",
    "next_actions",
    "base_writeback_payload",
    "missing_upstream_results"
  ],
  "properties": {
    "report_status": {
      "type": "string",
      "enum": ["ready", "degraded", "blocked"]
    },
    "report_title": { "type": "string" },
    "manager_id": { "type": "string" },
    "project_id": { "type": "string" },
    "report_type": {
      "type": "string",
      "enum": ["weekly_report"]
    },
    "summary": { "type": "string" },
    "indicator_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/indicator_result"
      }
    },
    "score_overview": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_backed_report_item"
      }
    },
    "key_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_backed_report_item"
      }
    },
    "risk_alerts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_backed_report_item"
      }
    },
    "human_review_items": {
      "type": "array",
      "items": { "type": "object" }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_backed_report_item"
      }
    },
    "base_writeback_payload": { "type": "object" },
    "missing_upstream_results": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "indicator_result": {
      "type": "object",
      "required": [
        "indicator_id",
        "dimension",
        "label",
        "value",
        "unit",
        "status",
        "source_type",
        "source_id",
        "evidence_refs"
      ],
      "properties": {
        "indicator_id": { "type": "string" },
        "dimension": { "type": "string" },
        "label": { "type": "string" },
        "value": {
          "type": ["number", "string", "null"]
        },
        "unit": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["available", "degraded", "no_sample", "missing"]
        },
        "source_type": {
          "type": "string",
          "enum": ["hard_metric", "soft_indicator"]
        },
        "source_id": { "type": "string" },
        "score": {
          "type": ["number", "null"]
        },
        "confidence": {
          "type": ["number", "null"]
        },
        "calculation_basis": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "evidence_backed_report_item": {
      "type": "object",
      "required": [
        "content",
        "evidence_refs"
      ],
      "properties": {
        "dimension": { "type": "string" },
        "level": { "type": "string" },
        "content": { "type": "string" },
        "evidence": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "source_type",
        "source_file",
        "source_id",
        "timestamp",
        "excerpt",
        "evidence_note"
      ],
      "properties": {
        "source_type": { "type": "string" },
        "source_file": { "type": "string" },
        "source_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "excerpt": { "type": "string" },
        "evidence_note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
