{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_engine_request.schema.json",
  "title": "ReviewEngineRequest",
  "type": "object",
  "required": [
    "task_context",
    "meeting_id",
    "project_id",
    "preliminary_result",
    "history_meetings",
    "history_signals"
  ],
  "properties": {
    "task_context": { "type": "object" },
    "meeting_id": { "type": "string" },
    "project_id": { "type": "string" },
    "preliminary_result": { "type": "object" },
    "history_meetings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["meeting_id", "summary"],
        "properties": {
          "meeting_id": { "type": "string" },
          "summary": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "history_signals": {
      "type": "object",
      "required": ["task_closure_notes", "risk_notes"],
      "properties": {
        "task_closure_notes": { "type": "array", "items": { "type": "string" } },
        "risk_notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
