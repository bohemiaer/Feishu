{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_result.schema.json",
  "title": "EvidenceResult",
  "type": "object",
  "required": ["meeting_id", "project_id", "statement_checks", "meeting_preliminary_result"],
  "properties": {
    "meeting_id": { "type": "string" },
    "project_id": { "type": "string" },
    "statement_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement_id",
          "statement_summary",
          "judgement",
          "confidence",
          "supporting_evidence",
          "conflict_evidence"
        ],
        "properties": {
          "statement_id": { "type": "string" },
          "statement_summary": { "type": "string" },
          "judgement": { "type": "string" },
          "confidence": { "type": "number" },
          "supporting_evidence": { "type": "array", "items": { "type": "string" } },
          "conflict_evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "meeting_preliminary_result": {
      "type": "object",
      "required": ["supported_ratio", "conflict_count", "high_risk_flag", "summary"],
      "properties": {
        "supported_ratio": { "type": "number" },
        "conflict_count": { "type": "integer" },
        "high_risk_flag": { "type": "boolean" },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
