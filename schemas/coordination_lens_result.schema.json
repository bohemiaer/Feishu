{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coordination_lens_result.schema.json",
  "title": "CoordinationLensResult",
  "type": "object",
  "required": [
    "meeting_id",
    "project_id",
    "manager_id",
    "dimension_findings",
    "human_review_items",
    "coordination_summary"
  ],
  "properties": {
    "meeting_id": { "type": "string" },
    "project_id": { "type": "string" },
    "manager_id": { "type": "string" },
    "dimension_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "finding_type",
          "summary",
          "evidence_refs",
          "confidence",
          "risk_tags",
          "suggested_actions"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": ["协同调度力"]
          },
          "finding_type": {
            "type": "string",
            "enum": ["strength", "risk", "observation", "no_sample"]
          },
          "summary": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence_ref"
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "risk_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "suggested_actions": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "human_review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "reason",
          "severity",
          "related_dimension",
          "evidence_refs"
        ],
        "properties": {
          "review_id": { "type": "string" },
          "reason": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "related_dimension": {
            "type": "string",
            "enum": ["协同调度力"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence_ref"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "coordination_summary": { "type": "string" }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": [
        "source_type",
        "source_file",
        "source_id",
        "timestamp",
        "excerpt",
        "evidence_note"
      ],
      "properties": {
        "source_type": { "type": "string" },
        "source_file": { "type": "string" },
        "source_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "excerpt": { "type": "string" },
        "evidence_note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
