{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "management_reviewer_result.schema.json",
  "title": "ManagementReviewerResult",
  "type": "object",
  "required": [
    "meeting_id",
    "project_id",
    "manager_id",
    "dimension_findings",
    "human_review_items",
    "management_review_summary"
  ],
  "properties": {
    "meeting_id": { "type": "string" },
    "project_id": { "type": "string" },
    "manager_id": { "type": "string" },
    "dimension_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "finding_type",
          "summary",
          "evidence_refs",
          "confidence",
          "risk_tags",
          "suggested_actions"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": ["方向校准力", "推进闭环力"]
          },
          "finding_type": {
            "type": "string",
            "enum": ["strength", "risk", "observation", "no_sample"]
          },
          "summary": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence_ref"
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "risk_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "suggested_actions": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "soft_indicators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/soft_indicator"
      }
    },
    "human_review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "reason",
          "severity",
          "related_dimension",
          "evidence_refs"
        ],
        "properties": {
          "review_id": { "type": "string" },
          "reason": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "related_dimension": {
            "type": "string",
            "enum": ["方向校准力", "推进闭环力"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence_ref"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "management_review_summary": { "type": "string" }
  },
  "$defs": {
    "soft_indicator": {
      "type": "object",
      "required": [
        "indicator_id",
        "dimension",
        "label",
        "value",
        "unit",
        "status",
        "score",
        "confidence",
        "score_basis",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "indicator_id": { "type": "string" },
        "dimension": {
          "type": "string",
          "enum": ["方向校准力", "推进闭环力"]
        },
        "label": { "type": "string" },
        "value": {
          "type": ["number", "string", "null"]
        },
        "unit": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["available", "degraded", "no_sample"]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score_basis": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "source_type",
        "source_file",
        "source_id",
        "timestamp",
        "excerpt",
        "evidence_note"
      ],
      "properties": {
        "source_type": { "type": "string" },
        "source_file": { "type": "string" },
        "source_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "excerpt": { "type": "string" },
        "evidence_note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
