{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_request.schema.json",
  "title": "TaskRequest",
  "type": "object",
  "required": ["task_id", "evaluation_target", "trigger_context", "source_config"],
  "properties": {
    "task_id": { "type": "string" },
    "evaluation_target": {
      "type": "object",
      "required": ["manager_id", "manager_name", "project_id", "evaluation_period", "current_meeting_id"],
      "properties": {
        "manager_id": { "type": "string" },
        "manager_name": { "type": "string" },
        "project_id": { "type": "string" },
        "evaluation_period": { "type": "string" },
        "current_meeting_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "trigger_context": {
      "type": "object",
      "required": ["trigger_type", "report_type", "audience"],
      "properties": {
        "trigger_type": {
          "type": "string",
          "enum": ["manual", "scheduled", "event", "risk"]
        },
        "report_type": {
          "type": "string",
          "enum": ["single", "periodic", "risk_alert"]
        },
        "audience": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "source_config": {
      "type": "object",
      "required": ["source_mode", "bundle_path"],
      "properties": {
        "source_mode": {
          "type": "string",
          "enum": ["case04_sample_bundle"]
        },
        "bundle_path": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
