{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_verifier_request.schema.json",
  "title": "EvidenceVerifierRequest",
  "type": "object",
  "required": [
    "task_context",
    "meeting_id",
    "project_id",
    "manager_id",
    "statements",
    "evidence_pool",
    "metrics"
  ],
  "properties": {
    "task_context": {
      "type": "object",
      "required": ["task_id", "project_id", "manager_id", "meeting_id", "evaluation_period", "status"],
      "properties": {
        "task_id": { "type": "string" },
        "project_id": { "type": "string" },
        "manager_id": { "type": "string" },
        "meeting_id": { "type": "string" },
        "evaluation_period": { "type": "string" },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "meeting_id": { "type": "string" },
    "project_id": { "type": "string" },
    "manager_id": { "type": "string" },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement_id", "statement_summary"],
        "properties": {
          "statement_id": { "type": "string" },
          "statement_summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence_pool": {
      "type": "object",
      "required": ["tasks", "risks", "documents"],
      "properties": {
        "tasks": { "type": "array", "items": { "type": "object" } },
        "risks": { "type": "array", "items": { "type": "object" } },
        "documents": {
          "type": "object",
          "required": ["project_goal", "weekly_highlights", "review_highlights"],
          "properties": {
            "project_goal": { "type": "string" },
            "weekly_highlights": { "type": "array", "items": { "type": "string" } },
            "review_highlights": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "action_item_count",
        "open_task_count",
        "overdue_task_count",
        "open_risk_count"
      ],
      "properties": {
        "action_item_count": { "type": "integer" },
        "open_task_count": { "type": "integer" },
        "overdue_task_count": { "type": "integer" },
        "open_risk_count": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
